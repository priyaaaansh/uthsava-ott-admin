PORT=3000
MONGO_URI=
REDIS_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_PASSWORD_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_EXPIRES_IN=10m
OTP_RESET_PASSWORD_EXPIRES_IN_SECONDS=600
ADMIN_URL=http://localhost:8080
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_CLOUDFRONT_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NODE_ENV=development

# Firebase Admin SDK (push notifications)
# Option A – use the downloaded service account JSON file (recommended for local dev)
# Place firebase.json at src/core/config/firebase.json — no env var needed.

# Option B – individual env vars (recommended for production / CI)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=""

# Option C – full service-account JSON as a single env var
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Web / VAPID (used by the admin-panel frontend, not the backend)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=
# FIREBASE_VAPID_KEY=
